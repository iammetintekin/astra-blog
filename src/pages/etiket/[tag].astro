---
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getPage } from '../../utils/pagination';
import { getPosts, getTags, type Post, slugify } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return getTags(posts).map((t) => ({
		params: { tag: t.slug },
		props: { name: t.name, posts: posts.filter((p) => p.data.tags.some((x) => slugify(x) === t.slug)) },
	}));
}

interface Props {
	name: string;
	posts: Post[];
}

const { name, posts } = Astro.props;
const page = getPage(posts, 1, `/etiket/${Astro.params.tag}/`);
---

<ListingLayout title={`#${name}`} description={`"${name}" etiketli yazılar`} page={page}>
	<p class="page-lead">Bu etikete sahip {posts.length} yazı. <a href="/kategori/">Tüm kategoriler ve etiketler →</a></p>
</ListingLayout>
