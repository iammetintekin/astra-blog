---
import CategoryGrid from '../components/CategoryGrid.astro';
import PostList from '../components/PostList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const latest = posts.slice(0, 4);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} width="wide">
	<section class="hero">
		<p class="eyebrow">Merhaba, ben</p>
		<h1>{AUTHOR.name}</h1>
		<p class="role">{AUTHOR.role}</p>
		<p class="bio">{AUTHOR.bio}</p>
		<div class="actions">
			<a class="button" href="/blog/">Yazıları oku</a>
			<a class="button secondary" href="/hakkimda/">Hakkımda</a>
		</div>
		<SocialLinks />
	</section>

	<section class="section">
		<div class="section-head">
			<h2>Kategoriler</h2>
			<a href="/kategori/">Tümü →</a>
		</div>
		<CategoryGrid posts={posts} />
	</section>

	<section class="section">
		<div class="section-head">
			<h2>Son yazılar</h2>
			<a href="/blog/">Tüm yazılar →</a>
		</div>
		<PostList posts={latest} emptyText="Henüz yazı yok — yakında!" />
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 2em 0 1em;
	}
	.eyebrow {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.hero h1 {
		margin: 0;
	}
	.role {
		margin: 0.25em 0 0;
		color: var(--accent);
		font-weight: 700;
	}
	.bio {
		max-width: 36em;
		margin: 1em 0 1.5em;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75em;
		margin-bottom: 1.5em;
	}
	@media (max-width: 720px) {
		.hero h1 {
			font-size: 2.441em;
		}
	}
</style>
