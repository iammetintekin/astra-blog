---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, type Post } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
			// Aynı kategorideki en yeni 2 yazı
			related: posts.filter((p) => p.data.category === post.data.category && p.id !== post.id).slice(0, 2),
		},
	}));
}

interface Props {
	post: Post;
	related: Post[];
}

const { post, related } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} related={related}>
	<Content />
</BlogPost>
