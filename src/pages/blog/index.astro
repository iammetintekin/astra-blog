---
import CategoryChips from '../../components/CategoryChips.astro';
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getPage } from '../../utils/pagination';
import { getPosts } from '../../utils/posts';

const posts = await getPosts();
const page = getPage(posts, 1, '/blog/');
---

<ListingLayout title="Yazılar" description="Tüm yazılar, en yeniden eskiye." page={page} emptyText="Henüz yazı yok — yakında!">
	<p class="page-lead">Tüm yazılar, en yeniden eskiye. Bir kategori seçerek filtreleyebilirsin.</p>
	<CategoryChips posts={posts} />
</ListingLayout>
