---
import CategoryChips from '../../components/CategoryChips.astro';
import { CATEGORIES, getCategory } from '../../consts';
import ListingLayout from '../../layouts/ListingLayout.astro';
import { getPage } from '../../utils/pagination';
import { getPosts } from '../../utils/posts';

export function getStaticPaths() {
	return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const category = getCategory(Astro.params.category);
const allPosts = await getPosts();
const posts = allPosts.filter((p) => p.data.category === category.slug);
const page = getPage(posts, 1, `/kategori/${category.slug}/`);
---

<ListingLayout
	title={category.name}
	description={category.description}
	page={page}
	emptyText="Bu kategoride henüz yazı yok — yakında!"
>
	<p class="page-lead">{category.description}</p>
	<CategoryChips posts={allPosts} active={category.slug} />
</ListingLayout>
