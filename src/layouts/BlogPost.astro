---
import { Image } from 'astro:assets';
import CategoryBadge from '../components/CategoryBadge.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostList from '../components/PostList.astro';
import { getCategory, SITE_TITLE } from '../consts';
import { type Post, slugify } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

type Props = Post['data'] & { related?: Post[] };

const { title, description, pubDate, updatedDate, heroImage, category, tags, draft, related = [] } =
	Astro.props;
---

<BaseLayout title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage} width="full">
	<article>
		<div class="hero-image">
			{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
		</div>
		<div class="prose">
			<div class="title">
				<div class="meta">
					<CategoryBadge slug={category} />
					<FormattedDate date={pubDate} />
					{draft && <span class="draft-label">Taslak</span>}
				</div>
				{
					updatedDate && (
						<div class="last-updated-on">
							Son güncelleme: <FormattedDate date={updatedDate} />
						</div>
					)
				}
				<h1>{title}</h1>
				{
					tags.length > 0 && (
						<ul class="tag-list">
							{tags.map((tag) => (
								<li>
									<a href={`/etiket/${slugify(tag)}/`}>#{tag}</a>
								</li>
							))}
						</ul>
					)
				}
				<hr />
			</div>
			<slot />
		</div>
	</article>
	{
		related.length > 0 && (
			<aside class="related">
				<div class="section-head">
					<h2>{getCategory(category).name} kategorisinden diğer yazılar</h2>
					<a href={`/kategori/${category}/`}>Tümü →</a>
				</div>
				<PostList posts={related} />
			</aside>
		)
	}
</BaseLayout>

<style>
	.hero-image {
		width: 100%;
	}
	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.prose {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
		color: rgb(var(--gray-dark));
	}
	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		text-align: center;
		line-height: 1;
	}
	.title h1 {
		margin: 0.4em 0 0.3em 0;
	}
	.meta {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.75em;
		color: rgb(var(--gray));
	}
	.last-updated-on {
		margin-top: 0.5em;
		font-style: italic;
		font-size: 0.8em;
		color: rgb(var(--gray));
	}
	.related {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: 3em auto 0;
		padding: 2em 1em 0;
		border-top: 1px solid rgb(var(--gray-light));
	}
</style>
